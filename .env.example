# Mumbai AirSense AI - Environment Variables Reference

# Environment Mode
ENV=development

# Database Settings
# For standalone local SQLite (zero-setup default):
DATABASE_URL=sqlite:///./airsense.db

# For local or Docker PostgreSQL:
# DATABASE_URL=postgresql://airsense_user:airsense_password@localhost:5432/airsense_db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=airsense_user
POSTGRES_PASSWORD=airsense_password
POSTGRES_DB=airsense_db

# External API Keys (Optional)
CPCB_API_KEY=
OPENAQ_API_KEY=
GEMINI_API_KEY=

# Administrative Key for CSV Ingestion
ADMIN_SECRET_KEY=mumbai-airsense-dev-secret-key-2026

# Frontend Configuration
NEXT_PUBLIC_API_BACKEND_URL=http://127.0.0.1:8000
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1
